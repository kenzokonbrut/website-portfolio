<title>Kalkulator Tabungan Siswa</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<style>
/* Layout: satu kolom sempit (maks 560px) di atas latar bukit hijau yang buram.
   Tiga panel kaca buram (liquid glass): form, hasil, rincian. Tema tunggal gelap-hijau, sengaja tanpa mode terang. */
:root {
  color-scheme: dark;
  --bg: #173222;
  --sky: #4f7d42;
  --mid: #2d5a36;
  --deep: #12281a;
  --sun: rgba(214, 236, 160, 0.34);
  --hill-1: rgba(120, 164, 80, 0.75);
  --hill-2: rgba(62, 122, 66, 0.8);
  --earth: rgba(112, 84, 52, 0.7);

  --fg: #f4f9ea;
  --muted: rgba(244, 249, 234, 0.76);
  --cream: #eaf5cf;
  --leaf: #c4e6a1;
  --gold: #efca8f;
  --warn: #ffd6a5;

  --glass-tint: rgba(14, 38, 24, 0.42);
  --glass-hi: rgba(255, 255, 255, 0.2);
  --glass-lo: rgba(255, 255, 255, 0.04);
  --glass-line: rgba(255, 255, 255, 0.28);
  --glass-shadow: 0 20px 44px rgba(5, 20, 10, 0.4);
  --field-bg: rgba(6, 20, 12, 0.4);
  --field-line: rgba(255, 255, 255, 0.24);
  --sticky: #1d3c27;
  --font-body: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
}

* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  padding-block: 28px 44px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
/* Latar: cahaya matahari lembut, bukit berlapis, tanah cokelat di sudut bawah */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(70% 34% at 92% 0%, var(--sun) 0%, transparent 72%),
    radial-gradient(90% 42% at 100% 34%, var(--hill-1) 0%, transparent 70%),
    radial-gradient(120% 48% at 0% 62%, var(--hill-2) 0%, transparent 72%),
    radial-gradient(90% 38% at 88% 100%, var(--earth) 0%, transparent 70%),
    linear-gradient(180deg, var(--sky) 0%, var(--mid) 46%, var(--deep) 100%);
}

.wrap { max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }

header { padding: 4px 4px 2px; }
header h1 { margin: 0 0 6px; font-size: 1.7rem; line-height: 1.15; font-weight: 800; text-wrap: balance; letter-spacing: -0.015em; text-shadow: 0 2px 16px rgba(5, 20, 10, 0.35); }
header p { margin: 0; color: var(--muted); max-width: 44ch; text-shadow: 0 1px 12px rgba(5, 20, 10, 0.35); }

/* Panel kaca */
.card, .result {
  background:
    linear-gradient(145deg, var(--glass-hi), var(--glass-lo) 60%),
    var(--glass-tint);
  -webkit-backdrop-filter: blur(22px) saturate(140%);
  backdrop-filter: blur(22px) saturate(140%);
  border: 1px solid var(--glass-line);
  border-radius: 26px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.34), var(--glass-shadow);
  min-width: 0;
}
.card { padding: 20px; }
.card h2 { margin: 0 0 16px; padding-bottom: 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.18); font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 10px; }
.card h2 svg { flex: none; color: var(--leaf); }

.fields { display: grid; gap: 14px; }
.row2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
.field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.field label { font-weight: 600; font-size: 0.86rem; color: var(--muted); }
.field input {
  font: inherit; color: var(--fg); width: 100%; min-width: 0;
  background: var(--field-bg);
  border: 1px solid var(--field-line);
  border-radius: 14px;
  padding: 12px 14px;
  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.18);
}
.field input:focus-visible, summary:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }
.hint { font-size: 0.8rem; color: var(--muted); }

.result { padding: 20px; }
.result .who { margin: 0 0 14px; font-size: 0.85rem; color: var(--muted); }
.result .who strong { color: var(--fg); font-weight: 700; overflow-wrap: anywhere; }
.result dl { margin: 0; display: grid; gap: 10px; }
.result .line { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.result dt { color: var(--muted); }
.result dd { margin: 0; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
.result .days { color: var(--gold); }
.result .rate { color: var(--leaf); }
.result .total {
  margin-top: 18px;
  padding: 14px 16px 16px;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.42);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.1));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 8px 20px rgba(5, 20, 10, 0.25);
  display: flex; flex-direction: column; gap: 2px;
}
.result .total span { color: var(--cream); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; }
.result .total strong { color: #fbffef; font-size: 2.1rem; font-weight: 800; line-height: 1.12; font-variant-numeric: tabular-nums; letter-spacing: -0.015em; text-shadow: 0 2px 10px rgba(5, 20, 10, 0.35); overflow-wrap: anywhere; }
.result .error { margin: 0; color: var(--warn); font-weight: 600; }

details.card { padding: 0; }
summary { cursor: pointer; padding: 16px 20px; font-weight: 700; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; border-radius: 26px; }
summary::-webkit-details-marker { display: none; }
summary::after { content: "Buka"; font-size: 0.82rem; font-weight: 600; color: var(--cream); background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.3); padding: 4px 14px; border-radius: 999px; }
details[open] summary::after { content: "Tutup"; }
.table-scroll { overflow-x: auto; padding: 0 20px 20px; max-height: 420px; overflow-y: auto; }
table { border-collapse: collapse; width: 100%; min-width: 440px; font-variant-numeric: tabular-nums; font-size: 0.88rem; }
th, td { padding: 8px 10px; text-align: right; border-bottom: 1px solid rgba(255, 255, 255, 0.14); white-space: nowrap; }
th:first-child, td:first-child, th:nth-child(2), td:nth-child(2) { text-align: left; }
thead th { position: sticky; top: 0; background: var(--sticky); color: var(--muted); font-weight: 600; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em; }
tbody tr:last-child td { font-weight: 700; color: var(--cream); border-bottom: 0; }

.note { margin: 0; padding: 0 4px; font-size: 0.85rem; color: var(--muted); text-shadow: 0 1px 10px rgba(5, 20, 10, 0.35); }
.note code { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; background: rgba(255, 255, 255, 0.14); color: var(--fg); padding: 2px 7px; border-radius: 8px; font-size: 0.85em; }
</style>

<main class="wrap">
  <header>
    <h1>Kalkulator Tabungan Siswa</h1>
    <p>Isi setoran harian dan rentang tanggal. Total tabungan dengan bunga 2% per hari langsung dihitung.</p>
  </header>

  <section class="card" aria-labelledby="judul-form">
    <h2 id="judul-form">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
      Simulator Parameter Tabungan Siswa
    </h2>
    <form class="fields" id="form" autocomplete="off">
      <div class="field">
        <label for="nama">Nama Siswa</label>
        <input id="nama" type="text" value="Rasya Setiawan Alfatih" maxlength="60">
      </div>
      <div class="field">
        <label for="setoran">Setoran Tabungan per Hari (Rp)</label>
        <input id="setoran" type="number" inputmode="numeric" min="1" step="1" value="10000">
      </div>
      <div class="row2">
        <div class="field">
          <label for="mulai">Tanggal Mulai Menabung</label>
          <input id="mulai" type="date" value="2026-10-26">
        </div>
        <div class="field">
          <label for="akhir">Pilih Tanggal Target Akhir</label>
          <input id="akhir" type="date" value="2026-11-25">
        </div>
      </div>
      <span class="hint">Maksimal 365 hari.</span>
    </form>
  </section>

  <section class="result" aria-live="polite" id="hasil"></section>

  <details class="card" id="rincian">
    <summary>Rincian per hari</summary>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Hari</th><th>Tanggal</th><th>Setoran</th><th>Bunga 2%</th><th>Saldo</th></tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </details>

  <p class="note">Rumus tiap hari: <code>saldo = (saldo + setoran) × 1,02</code>. Setoran masuk di awal hari, lalu bunga 2% dihitung di hari yang sama. Hasilnya sama dengan program C <code>tabungan_simpel.c</code>.</p>
</main>

<script>
(function () {
  var BUNGA = 0.02;
  var MAKS_HARI = 365;
  var $ = function (id) { return document.getElementById(id); };
  var rupiah = function (n) { return 'Rp ' + new Intl.NumberFormat('id-ID').format(n); };
  var angka = function (n) { return new Intl.NumberFormat('id-ID').format(n); };

  function parseTanggal(v) {
    if (!v) return null;
    var p = v.split('-').map(Number);
    return Date.UTC(p[0], p[1] - 1, p[2]);
  }

  function tulisError(pesan) {
    $('hasil').innerHTML = '<p class="error"></p>';
    $('hasil').firstChild.textContent = pesan;
    $('tbody').innerHTML = '';
  }

  function hitung() {
    var setoran = Math.floor(Number($('setoran').value));
    var a = parseTanggal($('mulai').value);
    var b = parseTanggal($('akhir').value);

    if (!setoran || setoran < 1) return tulisError('Isi setoran per hari dengan angka lebih dari 0.');
    if (a === null || b === null) return tulisError('Pilih tanggal mulai dan tanggal target akhir.');

    var hari = Math.round((b - a) / 86400000);
    if (hari < 1) return tulisError('Tanggal target akhir harus setelah tanggal mulai.');
    if (hari > MAKS_HARI) return tulisError('Rentang tanggal terlalu panjang. Maksimal ' + MAKS_HARI + ' hari.');

    var total = 0;
    var baris = [];
    for (var i = 1; i <= hari; i++) {
      var awal = total + setoran;
      var bunga = awal * BUNGA;
      total = awal + bunga;
      var tgl = new Date(a + (i - 1) * 86400000);
      baris.push(
        '<tr><td>' + i + '</td><td>' +
        tgl.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'UTC' }) +
        '</td><td>' + angka(setoran) + '</td><td>' + angka(Math.round(bunga)) +
        '</td><td>' + angka(Math.round(total)) + '</td></tr>'
      );
    }

    var tanpaBunga = setoran * hari;
    var totalAkhir = Math.round(total);
    var totalBunga = totalAkhir - tanpaBunga;
    var nama = $('nama').value.trim();

    $('hasil').innerHTML =
      '<p class="who">Simulasi untuk <strong></strong></p>' +
      '<dl>' +
      '<div class="line"><dt>Estimasi Jumlah Menabung</dt><dd class="days">' + hari + ' Hari</dd></div>' +
      '<div class="line"><dt>Bunga Per Hari</dt><dd class="rate">2% (0.02)</dd></div>' +
      '<div class="line"><dt>Total Tabungan Tanpa Bunga</dt><dd>' + rupiah(tanpaBunga) + '</dd></div>' +
      '<div class="line"><dt>Total Bunga</dt><dd>' + rupiah(totalBunga) + '</dd></div>' +
      '</dl>' +
      '<div class="total"><span>Total Akhir (+ bunga 2%/hari)</span><strong>' + rupiah(totalAkhir) + '</strong></div>';
    $('hasil').querySelector('strong').textContent = nama || 'Siswa';
    $('tbody').innerHTML = baris.join('');
  }

  $('form').addEventListener('submit', function (e) { e.preventDefault(); });
  ['nama', 'setoran', 'mulai', 'akhir'].forEach(function (id) {
    $(id).addEventListener('input', hitung);
  });
  hitung();
})();
</script>
